{
  "schemaVersion": 1,
  "kind": "theme",
  "id": "idle-help",
  "title": "Idle help",
  "type": "popup",
  "conditions": [
    {
      "include": true,
      "rule": "page",
      "value": "/popup-idle/"
    }
  ],
  "popup": {
    "layout": "bottom-bar",
    "triggers": {
      "inactivity": 5
    },
    "frequency": {
      "mode": "session"
    },
    "animation": "slide-up",
    "closeButton": true
  },
  "root": [
    {
      "id": "ih-c",
      "type": "base/Container",
      "version": 1,
      "props": {
        "contentWidth": "boxed",
        "tag": "div"
      },
      "slots": {
        "content": [
          {
            "id": "ih-t",
            "type": "base/Text",
            "version": 1,
            "props": {
              "text": "Need help finding something? We answer within a day."
            }
          },
          {
            "id": "ih-b",
            "type": "base/Button",
            "version": 1,
            "props": {
              "label": "Ask us",
              "link": "/contact/",
              "variant": "primary"
            }
          }
        ]
      }
    }
  ]
}
