{
  "schemaVersion": 1,
  "id": "features-mega",
  "title": "Features mega menu",
  "category": "Menus",
  "description": "Three columns for the main menu's Features item",
  "node": {
    "id": "fm",
    "type": "base/Container",
    "version": 1,
    "props": {
      "contentWidth": "boxed",
      "tag": "div"
    },
    "style": {
      "desktop": {
        "display": "grid",
        "gridColumns": "3",
        "gap": "24px",
        "paddingTop": "8px",
        "paddingBottom": "8px"
      },
      "mobile": {
        "gridColumns": "1"
      }
    },
    "slots": {
      "content": [
        {
          "id": "fm-a",
          "type": "base/Container",
          "version": 1,
          "props": {
            "contentWidth": "full",
            "tag": "div"
          },
          "slots": {
            "content": [
              {
                "id": "fm-a-h",
                "type": "base/Heading",
                "version": 1,
                "props": {
                  "text": "Build",
                  "level": 3
                }
              },
              {
                "id": "fm-a-t",
                "type": "base/Text",
                "version": 1,
                "props": {
                  "text": "Containers, widgets and templates you drag onto the page."
                }
              }
            ]
          }
        },
        {
          "id": "fm-b",
          "type": "base/Container",
          "version": 1,
          "props": {
            "contentWidth": "full",
            "tag": "div"
          },
          "slots": {
            "content": [
              {
                "id": "fm-b-h",
                "type": "base/Heading",
                "version": 1,
                "props": {
                  "text": "Style",
                  "level": 3
                }
              },
              {
                "id": "fm-b-t",
                "type": "base/Text",
                "version": 1,
                "props": {
                  "text": "Global colours and fonts, hover states and motion."
                }
              }
            ]
          }
        },
        {
          "id": "fm-c",
          "type": "base/Container",
          "version": 1,
          "props": {
            "contentWidth": "full",
            "tag": "div"
          },
          "slots": {
            "content": [
              {
                "id": "fm-c-h",
                "type": "base/Heading",
                "version": 1,
                "props": {
                  "text": "Publish",
                  "level": 3
                }
              },
              {
                "id": "fm-c-t",
                "type": "base/Text",
                "version": 1,
                "props": {
                  "text": "Every change is checked before the site is rebuilt."
                }
              },
              {
                "id": "fm-c-b",
                "type": "base/Button",
                "version": 1,
                "props": {
                  "label": "See all widgets",
                  "link": "/widgets/",
                  "variant": "primary"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
