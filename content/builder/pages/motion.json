      "type": "base/Container",
      "version": 1,
      "props": {
        "contentWidth": "boxed",
        "tag": "section"
      },
      "style": {
        "desktop": {
          "minHeight": "100vh",
          "justifyContent": "center"
        }
      },
      "slots": {
        "content": [
          {
            "id": "intro-h",
            "type": "base/Heading",
            "version": 1,
            "props": {
              "text": "Motion effects",
              "level": 1
            }
          },
          {
            "id": "intro-t",
            "type": "base/Text",
            "version": 1,
            "props": {
              "text": "Scroll down: the blocks below animate as they come into view."
            }
          }
        ]
      }
    },
