{
  "name": "builder-sandbox",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Builder sandbox: the demo site built and deployed to GitHub Pages on every publish. Not the ARD site.",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "builder-build-info && builder-fonts && next build && node scripts/image-variants.mjs && pagefind --site out --output-subdir pagefind --quiet"
  },
