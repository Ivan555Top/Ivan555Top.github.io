    "@acme/builder-timeline": "file:vendor/builder/acme-builder-timeline-1.1.0.tgz",
    "@builder/components-base": "file:vendor/builder/builder-components-base-0.44.0.tgz",
    "@builder/components-pro": "file:vendor/builder/builder-components-pro-0.44.0.tgz",
    "@builder/core": "file:vendor/builder/builder-core-0.44.0.tgz",
    "@builder/data": "file:vendor/builder/builder-data-0.44.0.tgz",
    "@builder/editor": "file:vendor/builder/builder-editor-0.44.0.tgz",
    "@builder/next": "file:vendor/builder/builder-next-0.44.0.tgz",
    "@builder/puck-bridge": "file:vendor/builder/builder-puck-bridge-0.44.0.tgz",
    "@builder/react": "file:vendor/builder/builder-react-0.44.0.tgz",
    "@builder/sdk": "file:vendor/builder/builder-sdk-0.44.0.tgz",
    "@puckeditor/core": "0.23.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19.2.0",
